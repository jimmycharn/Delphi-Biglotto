        XLS.Filename := SaveXLSDialog.FileName;
    end
    else
    begin
        XLS.Filename := SaveXLSDialog.FileName;
    end
  end
  else exit;


  XLS.Clear;
  // Add format #0
   with XLS.Formats.Add do begin
