function IsSubset(A, B: TStringList): Boolean;
var
  i: Integer;
begin
  Result := True;
  for i := 0 to A.Count - 1 do
  begin
    if B.IndexOf(A[i]) = -1 then
    begin
      Result := False;
      Break;
    end;
  end;
end;

function AreSetsEqual(A, B: TStringList): Boolean;
var
  i: Integer;
begin
  Result := False;

  // ตรวจสอบจำนวนสมาชิกของ A และ B ก่อน
  if A.Count <> B.Count then Exit;

  // ตรวจสอบสมาชิกของ A ว่าอยู่ใน B และสมาชิกของ B ว่าอยู่ใน A
  for i := 0 to A.Count - 1 do
  begin
    if B.IndexOf(A[i]) = -1 then Exit;
  end;

  for i := 0 to B.Count - 1 do
  begin
    if A.IndexOf(B[i]) = -1 then Exit;
  end;

  // ถ้าผ่านการตรวจสอบทั้งหมดให้คืนค่าเป็น True
  Result := True;
end;


