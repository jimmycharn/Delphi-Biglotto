      ArInp2 := nil;
      ArInp3 := nil;
      ArInp4 := nil;
      ArInp5 := nil;
      SumItem := nil;
      Sum1 := nil;

    end //record.count > 0
    else
    begin
      NiceGrid1.EndUpdate;
      NiceGrid2.EndUpdate;
      NiceGrid3.EndUpdate;
      NiceGrid4.EndUpdate;
      NiceGrid5.EndUpdate;
      InputGrid.EndUpdate;
      ClearSumGrid(SumGrid);
