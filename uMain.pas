          if (P1 <> '') and (Pos('*',P1) > 0) then
          begin
            if Not(FoundSpecNum) then
            begin

              B.Clear;
              for j := 1 to 4 do
                B.Add(Nums[j]);
              QrLocateNum.First;
              for i := 0 to QrLocateNum.RecordCount-1 do
