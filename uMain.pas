procedure TfMain.InSertDate(Const LstDate, LstRun: TDatetime);
Var QrRegis: TABSQuery;
begin
  with Dm do
  begin
    QrRegis := TABSQuery.Create(nil);
    QrRegis.DatabaseName := Database.DatabaseName;
    QrRegis.Close;
    QrRegis.SQL.Clear;
    QrRegis.SQL.Add('INSERT INTO Register (LastDate, LastRun, RPD)');
    QrRegis.SQL.Add('VALUES (:aLstDate, :aLstRun, :aRPD)');
    QrRegis.ParamByName('aLstDate').Value := LstDate;
    QrRegis.ParamByName('aLstRun').Value  := LstRun;
    QrRegis.ParamByName('aRPD').Value  := 0;
    QrRegis.ExecSQL;
    QrRegis.Free;
  end;
end;

function TfMain.ReadSerialNo: String;
var
  Z: TZQuery;
begin
  Result := '';
  try
    if Dm.ZConnection1.Connected then
    begin
      Z := TZQuery.Create(nil);
      try
        Z.Connection := Dm.ZConnection1;
        Z.SQL.Text := 'SELECT SERIAL FROM REGISTER';
        Z.Open;
        if not Z.Eof then
          Result := Z.Fields[0].AsString;
      finally
        Z.Free;
      end;
    end;
  except
  end;
end;

procedure TfMain.UpdateSerialNo(SNo: String);
var
  Z: TZQuery;
begin
  try
    if Dm.ZConnection1.Connected then
    begin
      Z := TZQuery.Create(nil);
      try
        Z.Connection := Dm.ZConnection1;
        Z.SQL.Text := 'UPDATE REGISTER SET SERIAL = :aSNo';
        Z.ParamByName('aSNo').AsString := SNo;
        Z.ExecSQL;
      finally
        Z.Free;
      end;
    end;
  except
  end;
end;

