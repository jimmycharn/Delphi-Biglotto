    if NumUp <> '' then
    begin
      if ((CountOccur('*',Pr) = 0) and (CountOccur('-',Pr) = 0) and (CountOccur('.',NumUp) = 0) and (CountOccur('+',NumUp) = 0)) Or (edPr.SelLength = Length(Pr)) then
      begin
