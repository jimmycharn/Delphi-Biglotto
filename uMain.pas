function CountUnique(const str: string): Integer;
var
  tripletSet: TStringList;
  i, j, k: Integer;
  sortedTriplet: string;
begin
  tripletSet := TStringList.Create;
  try
    tripletSet.Sorted := True;
    tripletSet.Duplicates := dupIgnore;

    for i := 1 to Length(str) - 2 do
      for j := i + 1 to Length(str) - 1 do
        for k := j + 1 to Length(str) do
        begin
          sortedTriplet := str[i] + str[j] + str[k];
          sortedTriplet := sortedTriplet[1] + sortedTriplet[2] + sortedTriplet[3];
          if tripletSet.IndexOf(sortedTriplet) = -1 then
            tripletSet.Add(sortedTriplet);
        end;

    Result := tripletSet.Count;
  finally
    tripletSet.Free;
  end;
end;

