    Statusbar.Panels[0].Text := 'BigLOTTO '+GetAppVersion+' (ติดต่อ โทร : 084-0643183) - '+'Firebird Database ('+Dm.ZConnection1.HostName+')';
  end;

  DBSerial := ReadSerialNo;
  RPDay    := ReadRPD;
  LastWork := ReadLastDate;
  LastRun  := ReadLastRun;

  if (Date > LastWork) and (LastWork = LastRun) then //ถ้าวันที่ปัจจุบันมากกว่าที่เข้าใช้ครั้งล่าสุด
  begin
    UpdateLastDate(Date);
    UpdateLastRun(Now);
    UpdateRPD(1);
  end
  else
  begin
    if (Date < LastWork) and (RPDay <= LimitRunPerday)  then
    begin
      UpdateRPD(LimitRunPerday+1);
      UpdateLastRun(Date);
      RPDay := LimitRunPerday+1;
    end
    else
      UpdateRPD(RPDay+1);
  end;

  if (RPDay >= LimitRunPerDay)  then //ถ้าวันที่เข้าทำงานล่าสุดมากกว่าวันที่ปัจจุบัน  หรือเข้าใช้มากกว่าที่กำหนดต่อวันเดิม
  begin
   Regis := false;
  end
  else
  begin
    HardwareID := GetHardwareID;
    SerialNo := DBSerial;
    if (SerialNo = '') then
    begin
      Regis := false;
      LbMDateExpr.Caption := 'ทดลองใช้งาน';
    end
    else
    begin
      SerialInfo := ValidateSerialWithExpiry(HardwareID, SerialNo);
      if not(SerialInfo.IsValid) Or SerialInfo.IsExpired then
      begin
        Regis := false;
        LbMDateExpr.Caption := 'ทดลองใช้งาน';
      end
      else
      begin
        Regis := true;
        AppKey := SerialNo;
        LbMDateExpr.Caption := 'เหลืออีก : ' + IntToStr(SerialInfo.DaysRemaining) + ' วัน';
      end;
    end;
  end;
end;

