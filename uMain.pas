      SaveXLSDialog.FileName := edExportFolder.Text+'\'+ GetComputerName+'_'+PanelCustName.Caption+'_'+formatDateTime('dd-mm-yy',DatePick.Date)+'_'+formatDateTime('HH-MM-SS',Now)
  end;
