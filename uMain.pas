  with Dm do
  begin
    with Numslist,InputGrid do
    begin
      Price1 := '0';
      Price2 := '0';

      if ValUp <> '' then
      begin
        StarPos := Pos('*',ValUP);
        LobPos  := Pos('-',ValUP);
        PlusPos := Pos('+',ValUP);

        if (Not (foundChar(ValUp,'*'))) and (Not (foundChar(ValUp,'-'))) and (Not (foundChar(ValUp,'+'))) then
        begin
            Price1 := ValUp;
            Price2 := '0';
        end
        else
