procedure TfMain.Look;
Var i: integer;
    Nums: String;
    ZQData: TZQuery;
    QData: TDataSet;
begin
  Nums := edFindData.Text;
  with Dm,InputGrid do
  begin
    if ZConnection1.Connected then
    begin
      ZQData := TZQuery.Create(nil);
      ZQData.Connection := ZConnection1;
      ZQData.SQL.Add('Select * from Data');
      ZQData.SQL.Add('Where (Period_Date = :pDate)');
      ZQData.SQL.Add('and (LotType = ' + IntToStr(ComboLotType.ItemIndex) + ' or LotType = ' + QuotedStr(edLotID.Text) + ')');
      if Not ChkTotal.Checked then
      begin
        if Not ChkSumBook.Checked then
          ZQData.SQL.Add('and (RefNo = ' + QuotedStr(edRefNo.Text) + ')');
        if Not ChkSumCust.Checked then
          ZQData.SQL.Add('and (CustNo = ' + QuotedStr(edCustNo.Text) + ')');
      end;
      if ChkLook.Checked and ChkSortInput.Checked then
        ZQData.SQL.Add('Order By ID ASC')
      else
        ZQData.SQL.Add('Order By ID DESC');

      ZQData.ParamByName('pDate').AsDate := DatePick.Date;
      try ZQData.Open; except end;
      QData := ZQData;
    end
    else
    begin
      QrData.Close;
      QrData.SQL.Clear;
      QrData.SQL.Add('Select * from data');
      QrData.SQL.Add('Where (Period_Date ="'+DateToStr(Datepick.Date)+'")');
      QrData.SQL.Add('and (LotType = "'+edLotID.Text+'")');
      if Not ChkTotal.Checked then
      begin
        if Not ChkSumBook.Checked then
          QrData.SQL.Add('and (RefNo = "'+edRefNo.Text +'")');
        if Not ChkSumCust.Checked then
          QrData.SQL.Add('and (CustNo = "'+edCustNo.Text+'")');
      end;
      if ChkLook.Checked and ChkSortInput.Checked then
        QrData.SQL.Add('Order By ID ASC')
      else
        QrData.SQL.Add('Order By ID DESC');
      try QrData.Open; except end;
      QData := QrData;
    end;

    if (QData <> nil) and QData.Active then
    begin
      RowCount := 0;
      QData.First;
      BeginUpDate;
      While Not QData.Eof do
      begin
        AddRow;
        InputGrid[0,RowCount-1] := QData.fieldByName('Num').AsString;
        InputGrid[1,RowCount-1] := QData.fieldByName('Up').AsString;
        InputGrid[2,RowCount-1] := QData.fieldByName('Dwn').AsString;
        InputGrid[3,RowCount-1] := QData.fieldByName('ID').AsString;
        InputGrid[4,RowCount-1] := QData.fieldByName('CustNo').AsString;
        QData.Next;
      end;
      EndUpDate;
    end;
    if (ZConnection1.Connected) and (QData <> nil) then QData.Free;
  end;
  lbItems1.Caption := IntToStr(inputGrid.RowCount)+' รายการ';
  ProcessBtnClick(self);
end;


