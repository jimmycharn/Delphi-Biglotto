procedure TfMain.Door(NGrid: TNiceGrid; StartRow: Integer);
Var SumDoor: Array of Integer;
    i,j: integer;
begin
  setlength(SumDoor,NGrid.ColCount-2);
  for i := 0 to NGrid.ColCount-3 do
    SumDoor[i] := 0;

  for i := 0 to Ngrid.RowCount-1 do
  begin

    for j := 1 to NGrid.ColCount-2 do
    begin
      if txtToFloat(NGrid[j,i]) > 0 then
      begin
        //showmessage(NGrid[0,i]+' '+NGrid[j,i]+' '+IntToStr(j-1));
        SumDoor[j-1] := SumDoor[j-1]+1;
      end;
    end;
  end;
  for i := StartRow to (StartRow+Ngrid.ColCount-3) do
  begin
    SumCutGrid[1,i] :=  IntToStr(SumDoor[i-StartRow]);
  end;

  setlength(SumDoor,0);
end;


procedure TfMain.SumNGrid(NGrid,SGrid: TNiceGrid; StartRow: Integer);
Var SumCol: Array of Real;
    RCount : Array of Integer;
    i,j: integer;
begin
  Setlength(SumCol,NGrid.ColCount-2);
  Setlength(RCount,NGrid.ColCount-2);
  With NGrid do
  begin
    for i := 1 to ColCount-2 do  //Set Zero
    begin
      SumCol[i-1] := 0;
      RCount[i-1] := 0;
    end;

    for i := 1 to ColCount-2 do
    begin
      for j := 0 To NGrid.RowCount-1 do
      begin
        SumCol[i-1] := SumCol[i-1] + txtToFloat(NGrid[i,j]);
        if txtToFloat(NGrid[i,j]) > 0 then
          RCount[i-1] := RCount[i-1]+1;
      end;
    end;

    for i := 0 to ColCount-3 do
    begin
      SGrid[0,i+StartRow] := formatFloat('###,###.##', SumCol[i]);
      SGrid[1,i+StartRow] := formatFloat('###,###', RCount[i]);
    end;
  end;
  Setlength(SumCol,0);
  Setlength(RCount,0);
end;

procedure TfMain.FormCreate(Sender: TObject);
Var IniFile: TIniFile;
    LastLogin,RegLastDate, WorkLastDate : TDateTime;
    size: longword;
    strList: TStringList;
    RegKey,Key,HardWareID, SerialNo: String;

    DriveNumber: Byte;
    HDDInfo: THDDInfo;
    LenDate,RPDay: Integer;
    StrDate,StrKey: String;
    SerialInfo: TSerialInfo;
begin
  //TotalRecFree  := ReadDataCount;
  IsKeyCount := false; //ยังไม่ได้นับเรคคอร์ดของ Data จากการ Key
  RunFirstTime := true;
  Sound1 := false;

  {
  WorkLastDate := StrToDate(Read_RegistKey('Config','LastDate'));
  RPDay := StrToInt(Read_RegistKey('Config','RPD'));

  if (Date > WorkLastDate) then //ถ้าวันที่ปัจจุบันมากกว่าที่เข้าใช้ครั้งล่าสุด
  begin
    Write_Registry('Config','LastDate',DateToStr(Date)); //ให้บันทึกลง Registry
    Write_Registry('Config','RPD','1'); //เริ่มวันใหม่ให้บันทึกจำนวนใช้งานแต่ละวันโดยเริ่มนับ 1 ใหม่
  end;

  if (WorkLastDate > Date) Or (RPDay >= LimitRunPerDay)  then //ถ้าวันที่เข้าทำงานล่าสุดมากกว่าวันที่ปัจจุบัน  หรือเข้าใช้มากกว่าที่กำหนด
  begin
   Regis := false;
  end
  else
  begin
    HardwareID := GetHardwareID;
    SerialNo := Read_RegistKey('Register','RegisKEY');
    if (SerialNo = '') then
    begin
      Regis := false;
      LbMDateExpr.Caption := 'ทดลองใช้งาน';
    end
    else
    begin
      SerialInfo := ValidateSerialWithExpiry(HardwareID, SerialNo);
      if not(SerialInfo.IsValid) Or SerialInfo.IsExpired then
      begin
        Regis := false;
        LbMDateExpr.Caption := 'ทดลองใช้งาน';
      end
      else
      begin
        Regis := true;
        AppKey := SerialNo;
        LbMDateExpr.Caption := 'เหลืออีก : ' + IntToStr(SerialInfo.DaysRemaining) + ' วัน';
      end;
    end;
  end;
  }

  Application.HelpFile := ExtractFilePath(Application.ExeName)+'BIGLOTTO.HLP';
  DateSpecNum := DatePick.Date;
  SoundOn := true;
  Statusbar.Panels[0].Text := 'BigLOTTO '+GetAppVersion+' (Line ID : 0910356437) - '+'Firebird Database ('+Dm.ZConnection1.HostName+')';
  isup :=  true;
  LottoID := StrToInt(EdLotID.Text);
end;

procedure TfMain.QrSortNum(Num,Value:String; IsUpNum:Boolean);
Var Nums: Array of String[3];
    Price: Array[1..6] of real;
    NumCount,i,StarPos: Integer;
    Price1,Price2: String;
begin
  StarPos:= Pos('*',Value);
  if (foundChar(Value,'*')) then
  begin
    StarPos:= Pos('*',Value);
    if StarPos = 1 then
    begin
      Price1 := Copy(Value,2,length(Value)-1);
      Price2 := Copy(Value,2,length(Value)-1);
    end
    else
    begin
      Price1 := Copy(Value,1,StarPos-1);
      Price2 := Copy(Value,StarPos+1,length(Value)-StarPos);
    end;
  end;
  
  with Numslist do
  begin
      if (Num[1] = Num[2]) and (Num[2] = Num[3]) and (Num[3] = Num[1]) then
      begin
        setlength(Nums,1);
        Nums[0] := Num;

         if IsUpNum then
         begin
          ArCut3[0,StrToInt(Num)] := Num;
          ArCut3[1,StrToInt(Num)] := FormatFloat('##0.##', StrToFloatDef(ArCut3[1,StrToInt(Num)],0) +StrToFloat(Price1) );
         end
         else
         begin
          ArCut3[0,StrToInt(Num)] := Num;
          ArCut3[3,StrToInt(Num)] := FormatFloat('##0.##', StrToFloatDef(ArCut3[3,StrToInt(Num)],0) +StrToFloat(Price1) );
         end;

        NumCount := 1;
      end
      else
      if (Num[1] <> Num[2]) and (Num[2] <> Num[3]) and (Num[3] <> Num[1]) then
      begin
         setlength(Nums,6);
         Nums[0] := Num;
         Nums[1] := Num[1]+Num[3]+Num[2];
         Nums[2] := Num[2]+Num[1]+Num[3];
         Nums[3] := Num[2]+Num[3]+Num[1];
         Nums[4] := Num[3]+Num[1]+Num[2];
         Nums[5] := Num[3]+Num[2]+Num[1];

