  if (Date > LastWork) and (LastWork = LastRun) then //ถ้าวันที่ปัจจุบันมากกว่าที่เข้าใช้ครั้งล่าสุด
  begin
    UpdateLastDate(Date);
    UpdateLastRun(Date);
    UpdateRPD(1);
