          if (P1 <> '') and (Pos('*',P1) > 0) and IsLastStr(P1,'*') then  // 12345 = 100*
          begin
              SellItem  := StrToFloatDef(Copy(P1,1,Length(P1)-1),0)*Permutation(Nums);
