function CountDup(Str: String): integer;
Var
   i,j,count: integer;
begin
  count := 0;
  for i := 1 to Length(Str) do
  begin
    for j := 1 to Length(Str) do
    begin
      if i <> j then
      begin
        if Str[i] = Str[j] then
        begin
          count := count+1;
        end

      end;
    end;
  end;
  result := count;
end;

procedure ClearSumGrid(SGrid: TNiceGrid);
Var i : integer;
begin
  SGrid.BeginUpdate;
  for i := 0 to SGrid.RowCount-1 do
  begin
    SGrid[0,i] := '';
    SGrid[1,i] := '';
  end;
  Sgrid.Columns[0].Footer := '0';
  Sgrid.Columns[1].Footer := '0';
  SGrid.EndUpdate;
end;

procedure QuickSort(var A: array of Integer; iLo, iHi: Integer) ;
 var
   Lo, Hi, Pivot, T: Integer;
begin
   Lo := iLo;
   Hi := iHi;
   Pivot := A[(Lo + Hi) div 2];
   repeat
     while A[Lo] < Pivot do Inc(Lo) ;
     while A[Hi] > Pivot do Dec(Hi) ;
     if Lo <= Hi then
     begin
       T := A[Lo];
       A[Lo] := A[Hi];
       A[Hi] := T;
       Inc(Lo) ;
       Dec(Hi) ;
     end;
   until Lo > Hi;
   if Hi > iLo then QuickSort(A, iLo, Hi) ;
   if Lo < iHi then QuickSort(A, Lo, iHi) ;
end;

procedure SumsGrid(SGrid: TNiceGrid);
Var i,SumItems : integer;
    SumMoney,SumCom: Real;
begin
  SumMoney := 0;
  SumCom   := 0;
  SumItems := 0;
  Sgrid.BeginUpdate;
  for i := 0 to SGrid.RowCount-1 do
  begin
    SumMoney   := SumMoney + txttoFloat(SGrid[0,i]);
    //SumCom     := SumCom  + txtToFloat(SGrid[0,i])*(TxtToFloat(SGrid[2,i])/100);
    if StrToFloatDef(SGrid[1,i],0) <> 0 then
      SumItems   := SumItems + StrToInt(SGrid[1,i]);
  end;
  Sgrid.Columns[0].Footer := FormatFloat('#,###.##',SumMoney);
  //Sgrid.Columns[1].Footer := FormatFloat('#,###.##',Round(SumCom));
  Sgrid.Columns[1].Footer := FormatFloat('#,###',SumItems);
  SGrid.EndUpdate;
end;

