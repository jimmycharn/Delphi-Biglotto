procedure TfMain.Totalsales;
Var foundCust,FoundNumPay,FoundNum,Is3ToTeng,Is4ToTeng,Is5ToTeng: Boolean;
    i,j,k,CustNoInt,Ns,Ns2Int,Nms,ANs,CntPmu,LastAr4,LastAr5: integer;
