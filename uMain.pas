procedure TfMain.CheckCorectNum(InputData,P1,P2,ID,CustID,RefID: String; IsChkTotal: Boolean);
Var FoundCorctNum: Boolean;
    Numb,Nums,TbNum,CD1,CD2,CD3,CD4: String;
    i,Pa,Pb: integer;
    C2Left,C2Tang,C2Up,C2Dwn,C3Up,C3UpTemp,C4Up,C5UP,Num,Win: String;
    CDwn: Array of String;
begin
  setlength(CDwn,4);
  if length(LotNum6.Text) >= 5 then
    C5Up    := Copy(LotNum6.Text,length(LotNum6.Text)-4,5); // เลขที่ออก 5 ตัวตรง

  if length(LotNum6.Text) >= 4 then
    C4Up    := Copy(LotNum6.Text,length(LotNum6.Text)-3,4); // เลขที่ออก 4 ตัวตรง

  if length(LotNum6.Text) >= 3 then
    C3Up    := Copy(LotNum6.Text,length(LotNum6.Text)-2,3); // เลขที่ออก 3 ตัวตรง

  C2Left  := Copy(LotNum6.Text,length(LotNum6.Text)-2,2);  // เลขที่ออก 2 ตัวหน้า
  C2Tang  := C3UP[1]+C3UP[3]; // เลขที่ออก 2 ตัวถ่าง
  C2Up    := Copy(LotNum6.Text,length(LotNum6.Text)-1,2); // เลขที่ออก 2 ตัวบน
  C2Dwn   := lotNum2.Text; // เลขที่ออก 2 ตัวล่าง
  CDwn[0] := lotNum31.Text; // เลขที่ออก 3 ตัวล่าง ชุดที่ 1
  CDwn[1] := lotNum32.Text; // เลขที่ออก 3 ตัวล่าง ชุดที่ 2
  CDwn[2] := lotNum33.Text; // เลขที่ออก 3 ตัวล่าง ชุดที่ 3
  CDwn[3] := lotNum34.Text; // เลขที่ออก 3 ตัวล่าง ชุดที่ 4
  Pa := 0;
  Pb := 0;

  if Not(IsChkTotal) then
  begin
    Numb := InputData;
    With Dm do
    begin
      if ChkShowOverLimt.Checked then
      begin
        FoundCorctNum := false;

   //-------------------------------------------------------------------------------------------------------------//
        if ((Length(Numb) = 1) and (Numb[1] in ['0'..'9'])) Or // 1
           ((Length(Numb) = 2) and (Numb[1] in ['0'..'9']) and Not(Numb[2] in ['0'..'9'])) or // 1-
           ((Length(Numb) = 2) and Not(Numb[1] in ['0'..'9']) and (Numb[2] in ['0'..'9'])) or // -1
           ((Length(Numb) = 3) and Not(Numb[1] in ['0'..'9']) and (Numb[2] in ['0'..'9'])) and Not(Numb[3] in ['0'..'9']) then // -1-
        begin
          if ((Length(Numb) = 1) and (Numb[1] in ['0'..'9'])) Or
             ((Length(Numb) = 2) and (Numb[1] in ['0'..'9']) and Not(Numb[2] in ['0'..'9'])) then
            Nums := Numb[1];
  
          if ((Length(Numb) = 2) and Not(Numb[1] in ['0'..'9']) and (Numb[2] in ['0'..'9']) ) Or
             ((Length(Numb) = 3) and Not(Numb[1] in ['0'..'9']) and (Numb[2] in ['0'..'9']) and Not(Numb[3] in ['0'..'9'])) then
            Nums := Numb[2];

          if ((P1 <> '') and (Length(Numb) = 1) and (Numb[1] in ['0'..'9'])) then  // 1, 2, 3  ลอยบน
          begin

            if Not(FoundCorctNum) then
            begin
              //FoundCorctNum  := IsNumTod(Nums,C3Up); //กำหนด argument ให้เลขความยาวน้อยอยู่หน้า
              FoundCorctNum  := ( Nums[1]  in [ C3Up[1],C3Up[2],C3Up[3] ]);
              if FoundCorctNum then
              begin
                //Showmessage('ลอยบน');
                Win := P1;
              end;
            end;
          end;

          if ((P1 <> '') and (Length(Numb) = 2) and (Numb[1] in ['0'..'9']) and Not(Numb[2] in ['0'..'9'])) then // 1-
          begin
            if Not(FoundCorctNum) then
            begin
              FoundCorctNum  := Nums = C3Up[1];
              if FoundCorctNum then
              begin
                //Showmessage('ปักหน้าบน');
                Win := P1;
              end;
            end;
          end;

          if ((P1 <> '') and (Length(Numb) = 3) and Not(Numb[1] in ['0'..'9']) and (Numb[2] in ['0'..'9'])) and Not(Numb[3] in ['0'..'9']) then // -1-
          begin
            if Not(FoundCorctNum) then
            begin
              FoundCorctNum  := Nums = C3Up[2];
              if FoundCorctNum then
              begin
                //Showmessage('ปักกลางบน');
                Win := P1;
              end;
            end;
          end;

          if ((P1 <> '') and (Length(Numb) = 2) and Not(Numb[1] in ['0'..'9']) and (Numb[2] in ['0'..'9'])) then  // -1
          begin
            if Not(FoundCorctNum) then
            begin
              FoundCorctNum  := Nums = C3Up[3];
              if FoundCorctNum then
              begin
                //Showmessage('ปักหลังบน');
                Win := P1;
              end;
            end;
          end;

          if ((P2 <> '') and (Length(Numb) = 1) and (Numb[1] in ['0'..'9'])) then  // 1, 2, 3  //ลอยล่าง
          begin
            if Not(FoundCorctNum) then
            begin
              FoundCorctNum  := ( Nums[1]  in [ C2Dwn[1],C2Dwn[2] ]);
              if FoundCorctNum then
              begin
                //Showmessage('ลอยล่าง');
                Win := P2;
              end;
            end;
          end;

          if ((P2 <> '') and (Length(Numb) = 2) and (Numb[1] in ['0'..'9']) and Not(Numb[2] in ['0'..'9'])) then // 1-
          begin
            if Not(FoundCorctNum) then
            begin
              FoundCorctNum  := Nums = C2Dwn[1];
              if FoundCorctNum then
              begin
                //Showmessage('ปักหน้าล่าง');
                Win := P2;
              end;
            end;
          end;

          if ((P2 <> '') and (Length(Numb) = 2) and Not(Numb[1] in ['0'..'9']) and (Numb[2] in ['0'..'9'])) then  // -1
          begin
            if Not(FoundCorctNum) then
            begin
              FoundCorctNum  := Nums = C2Dwn[2];
              if FoundCorctNum then
              begin
                //Showmessage('ปักหลังล่าง');
                Win := P2;
              end;
            end;
          end;

        end;
   //-------------------------------------------------------------------------------------------------------------//

        if ((Length(Numb) = 2) and (Numb[1] in ['0'..'9']) and (Numb[2] in ['0'..'9'])) Or
           ((Length(Numb) = 3) and (Numb[1] in ['0'..'9']) and (Numb[2] in ['0'..'9']) and Not(Numb[3] in ['0'..'9'])) or
           ((Length(Numb) = 3) and (Numb[1] in ['0'..'9']) and Not(Numb[2] in ['0'..'9'])) and (Numb[3] in ['0'..'9']) then //12, 25+, 45-, 7-8
        begin
          if ((Length(Numb) = 2) and (Numb[1] in ['0'..'9']) and (Numb[2] in ['0'..'9'])) Or
             ((Length(Numb) = 3) and (Numb[1] in ['0'..'9']) and (Numb[2] in ['0'..'9']) and Not(Numb[3] in ['0'..'9'])) then
            Nums := Numb[1]+Numb[2];

          if ((Length(Numb) = 3) and (Numb[1] in ['0'..'9']) and Not(Numb[2] in ['0'..'9'])) and (Numb[3] in ['0'..'9']) then  // 7-8
            Nums := Numb[1]+Numb[3];
  
          //----------------------------------------
          if ((P1 <> '') and (Pos('-',P1) = 0) and (Pos('*',P1) = 0) and (Length(Numb) = 2) and (Numb[1] in ['0'..'9']) and (Numb[2] in ['0'..'9'])) then // 12, 28, 34
          begin
            if Not(FoundCorctNum) then
            begin
              FoundCorctNum  := Nums = C2Up;
              if FoundCorctNum then
              begin
                //Showmessage('2 ตัวบน');
                Win := P1;
              end;
            end;
          end;
          //----------------------------------------//

          //---------------2 ตัวบนกลับ--------------//
          if ((P1 <> '') and (Pos('*',P1) > 0) and (Length(Numb) = 2) and (Numb[1] in ['0'..'9']) and
             (Numb[2] in ['0'..'9'])) and Not(IsLastStr(P1,'*3') Or IsLastStr(P1,'*6')) then // 12=100*20
          begin
            if Not(FoundCorctNum) then
            begin
              FoundCorctNum  := IsNumTod(C2Up,Nums);
