    with InputGrid do
    begin
      if InputGrid[1,Row] <> '' then
      begin
        ChkEdit.Checked := Not ChkLook.Checked;
        edNumup.Text := InputGrid[0,Row];
        edNumDwn.Text := '';
        edPr.Text  := InputGrid[1,Row];
        edNumUp.SetFocus;
      end
      else
      begin
        ChkEdit.Checked := Not ChkLook.Checked;
        edNumDwn.Text := InputGrid[0,Row];
        edNumUp.Text := '';
        edPr.Text  := InputGrid[2,Row];
        edNumDwn.SetFocus;
      end;
    end;
    Key := 0;
  end;
  
end;

