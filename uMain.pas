procedure TfMain.BtnBookNoClick(Sender: TObject);
Var QrMaxBook: TABSQuery;
    MaxNo: Integer;
begin
  With Dm do
  begin
    QrMaxBook := TABSQuery.Create(nil);
    QrMaxBook.DatabaseName := Database.DatabaseName;
    QrMaxBook.Close;
    QrMaxBook.SQL.Clear;
    QrMaxBook.SQL.Add('Select Max(CAST(RefNo AS integer)) as mxn from Data');
    QrMaxBook.SQL.Add('Where (LotType = "'+edLotID.Text+'")');
    QrMaxBook.SQL.Add('and (Period_Date ="'+DateToStr(Datepick.Date)+'")');
    QrMaxBook.SQL.Add('and (CustNo ="'+edCustNo.Text+'")');
    QrMaxBook.Open;

    try
      MaxNo := QrMaxBook.fieldByName('mxn').AsInteger;
      if MaxNo > 0 then
        MaxNo := MaxNo + 1
      else
        MaxNo := 1;

      if edRefNo.Text <> IntToStr(MaxNo) then
      begin
        edRefNo.Text := IntToStr(MaxNo);
        NewRefreshBtnClick(Sender);
      end;
    except
      edRefNo.Text := '1';
    end
 end;
end;


