        if (ChkNewInput.Checked) then
        begin
          if (CountOccur('*',Pr) = 0) then
          begin
            edPr.Text := Pr+'*'+IntToStr(Permutation(NumUp)-1)+'*';
            edPr.SelStart := Length(Pr)+3;
          end
          else
