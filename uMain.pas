          //----------------------------------------------------------------------------------//

          if Num5Tod > 0 then  //12345 = -100
          begin
              SellItem  := Num5Tod;//StrToFloatDef(Copy(P1,Pos('-',P1)+1,Length(P1)-Pos('-',P1)),0);
