function Permutation2(Num: String): Integer;
var
  i, j, k, Count: Integer;
  Str,PreStr: String;
  Numbers: array of Integer;
begin
  if Length(Num) = 2 then
  begin
    if Num[1] = Num[2] then
      Result := 1
    else
      Result := 2;
  end
  else
  begin
    SetLength(Numbers,Length(Num));
    for i := 0 to High(Numbers) do
      Numbers[i] := StrToInt(Num[i+1]);

    Count := 0;
    Str := '';
    for i := 0 to High(Numbers) do
    begin
      for j := 0 to High(Numbers) do
      begin
        if j <> i then
        begin
          for k := 0 to High(Numbers) do
            if (k <> i) and (k <> j) then
            begin
              PreStr := IntToStr(Numbers[i]) + IntToStr(Numbers[j]) + IntToStr(Numbers[k]);
              if Pos(PreStr,Str) = 0 then
              begin
                Str := Str + PreStr + #13#10;
                Inc(Count);
              end;
            end;
        end;
      end;
    end;
    Numbers := nil;
    Result := Count;
  end;
end;

