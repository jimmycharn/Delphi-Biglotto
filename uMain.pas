function TotalPr3(NumPmu,Pr:String; Teng: Boolean):Integer;
Var Pa,Pb: Integer;
begin
    Pa := 0;
    Pb := 0;
    Result := 0;

    if (Pos('-',Pr) = 0) And (Pos('*',Pr) = 0) then
    begin
      if Teng then
        Result := StrToInt(Pr)
      else
        Result := 0;
    end
    else
    if (Pos('*',Pr) = Length(Pr)) then  //สัญลักษณ์อยู่ตัวสุดท้ายของราคา  123 = 100*
    begin
      if Teng then
        Result := StrToInt(Copy(Pr,1,Length(Pr)-1)) * PerMutation(NumPmu)
      else
        Result := 0;
    end
    else
    if (Pos('-',Pr) = 1) then  //สัญลักษณ์อยู่ตัวแรกของราคา  123 = -100
    begin

      if Teng then
        Result := 0
      else
        Result := StrToInt(Copy(Pr,2,Length(Pr)-1));
    end
    else
    if ((Pos('*',Pr) > 1) and (Pos('*',Pr) < Length(Pr))) Or ((Pos('-',Pr) > 1) and (Pos('-',Pr) < Length(Pr)))  then   //123 = 100*100, 456 = 100-50
    begin

      if (Pos('-',Pr) > 1) then
      begin
        Pa := StrToInt(Copy(Pr,1,Pos('-',Pr)-1));
        Pb := StrToInt(Copy(Pr,Pos('-',Pr)+1,Length(Pr)-Pos('-',Pr)));
      end
      else
      begin
        Pa := StrToInt(Copy(Pr,1,Pos('*',Pr)-1));
        Pa := Pa + StrToInt(Copy(Pr,Pos('*',Pr)+1,Length(Pr)-Pos('*',Pr))) * (PerMutation(NumPmu)-1);
        Pb := 0;
      end;

      if Teng then
        Result := Pa
      else
        Result := Pb;
    end;

end;


function IsNumTod(Num,LongNum: String):Boolean;
Var IsTodNum: Boolean;
    CorTmp: String;
    i,j,Count,least,most: integer;
begin
  Result := false;
  if Num <> '' then
  begin
    IsTodNum := false;
    Count := 0;
    for i := 1 to Length(Num) do
    begin
      for j := 1 to Length(LongNum) do
      begin
        if Num[i] = LongNum[j] then //ถ้าเลขแต่ละตัวใน Num พบว่ามีอยู่ใน LongNum
        begin
          LongNum[j] := '-'; //ให้กาเครื่องหมาย - ทับเลขนั้นซะ เพื่อ loop รอบหลังได้ไม่เจอ
          Inc(Count);
          Break;
        end;
      end;
    end;
    if Count >= Length(Num) then //ถ้าเลขที่กา - ทับมีมากกว่าหรือเท่ากับจำนวนเลขทั้งหมดใน Num
      Result := true;
  end;
end;

