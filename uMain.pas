procedure TfMain.Timer1Timer(Sender: TObject);
Var HardwareID, SerialNo: String;
    SerialInfo: TSerialInfo;
begin
  lbClock.Caption := formatDateTime('HH:MM:SS',Now);

  if Not(Regis) then
    LbMDateExpr.Caption := 'ทดลองใช้งาน';

  if (lbClock.Caption = '00:00:00') then
  begin
    HardwareID := GetHardwareID;
    SerialNo := Trim(AppKey);
    if (SerialNo = '') Or Not(Regis) then
    begin
      LbMDateExpr.Caption := 'ทดลองใช้งาน';
    end
    else
    begin
      SerialInfo := ValidateSerialWithExpiry(HardwareID, SerialNo);
      if not(SerialInfo.IsValid) Or SerialInfo.IsExpired then
      begin
        LbMDateExpr.Caption := 'ทดลองใช้งาน';
      end
      else
        LbMDateExpr.Caption := 'เหลืออีก : ' + IntToStr(SerialInfo.DaysRemaining) + ' วัน';
    end;
  end;
end;

