procedure TfMain.Open1Click(Sender: TObject);
Var IniFile: TiniFile;
    DBFN: String;
    DBSerial, HardwareID, SerialNo: String;
    RPDay: Integer;
    LastWork: TDatetime;
    LastRun: TDatetime;
    SerialInfo: TSerialInfo;
begin
  with Dm do
  begin
    if OpenDBDialog.Execute then
    begin
      Database.Connected := false;

      DBFN  := OpenDBDialog.FileName;
      IniFile := TIniFile.Create(
          ChangeFileExt(Application.ExeName,'.ini'));

      if ChkHost.Checked then
      begin
        IniFile.WriteString('DB','DBFile',DBFN);
        edServerDb.Text := DBFN;
        IniFile.WriteString('DB','ServDBFile',edServerDB.Text);
      end
      else
        IniFile.WriteString('DB','DBFile',DBFN);

      
      Database.DatabaseFileName := DBFN;
      Database.Connected := true;

      Database.Connected := false;
      Database.DatabaseFileName := DBFN;

      // 1. ตรวจสอบว่ามีตาราง 'Register' หรือยัง
      // ใช้ฟังก์ชัน .TableExists ของ ABSDatabase โดยตรง (แม่นยำกว่า SQL)
      if not Database.TableExists('Register') then
      begin
        // ถ้ายังไม่มี ให้สร้างตาราง
        QrAddCol.Close;
        QrAddCol.SQL.Clear;
        QrAddCol.SQL.Add('CREATE TABLE Register ( ' +
                       '  Serial STRING(50), ' +
                       '  LastDate DATE CURRENT_DATE, ' +
                       '  LastRun DATETIME NOW, ' +
                       '  RPD INTEGER 1' +
                       ')');
        QrAddCol.ExecSQL;
        InSertDate(Date, Now);
      end;

      if not Database.TableExists('Cut') then
      begin
        // ถ้ายังไม่มี ให้สร้างตาราง
        {
        QrAddCol.Close;
        QrAddCol.SQL.Clear;
        //QrAddCol.SQL.Add('ALTER TABLE Cut');
        QrAddCol.SQL.Add('CREATE TABLE Register ( ' +
                         '  Serial STRING(50), ' +
                         '  LastDate DATE, ' +
                         '  LastRun DATETIME, ' +
                         '  RPD INTEGER ' +
                         ')');
        //QrAddCol.ExecSQL;
        }
        Showmessage('เกิดข้อผิพลาด ไม่พบ Table CUT ในฐานข้อมูล');
        Exit;
      end
      else
      begin
        try
          QrAddCol.SQL.Add('ALTER TABLE Cut ADD (IF NOT EXISTS Is3TTeng LOGICAL)');
          QrAddCol.ExecSQL;
        except
          // ถ้า Error แสดงว่ามีฟิลด์นี้อยู่แล้ว ให้ข้ามไป (เงียบไว้)
        end;

        try
          QrAddCol.SQL.Add('ALTER TABLE Cut ADD (IF NOT EXISTS Is4TTeng LOGICAL)');
          QrAddCol.ExecSQL;
        except
          // ถ้า Error แสดงว่ามีฟิลด์นี้อยู่แล้ว ให้ข้ามไป (เงียบไว้)
        end;

        try
          QrAddCol.SQL.Add('ALTER TABLE Cut ADD (IF NOT EXISTS Is5TTeng LOGICAL)');
          QrAddCol.ExecSQL;
        except
          // ถ้า Error แสดงว่ามีฟิลด์นี้อยู่แล้ว ให้ข้ามไป (เงียบไว้)
        end;
      end;

      if not Database.TableExists('LimitNum') then
      begin
        // ถ้ายังไม่มี ให้สร้างตาราง
        {
        QrAddCol.Close;
        QrAddCol.SQL.Clear;
        //QrAddCol.SQL.Add('ALTER TABLE Cut');
        QrAddCol.SQL.Add('CREATE TABLE Register ( ' +
                         '  Serial STRING(50), ' +
                         '  LastDate DATE, ' +
                         '  LastRun DATETIME, ' +
                         '  RPD INTEGER ' +
                         ')');
        //QrAddCol.ExecSQL;
        }
        Showmessage('เกิดข้อผิพลาด ไม่พบ Table LimitNum ในฐานข้อมูล');
        Exit;
      end
      else
      begin
        try
          QrAddCol.SQL.Add('ALTER TABLE LimitNum ADD (IF NOT EXISTS PayPcnt1 FLOAT)');
          QrAddCol.ExecSQL;
        except
          // ถ้า Error แสดงว่ามีฟิลด์นี้อยู่แล้ว ให้ข้ามไป (เงียบไว้)
        end;

        try
          QrAddCol.SQL.Add('ALTER TABLE LimitNum ADD (IF NOT EXISTS PayPcnt2 FLOAT)');
          QrAddCol.ExecSQL;
        except
          // ถ้า Error แสดงว่ามีฟิลด์นี้อยู่แล้ว ให้ข้ามไป (เงียบไว้)
        end;

        try
          QrAddCol.SQL.Add('ALTER TABLE LimitNum ADD (IF NOT EXISTS PayPcnt3 FLOAT)');
          QrAddCol.ExecSQL;
        except
          // ถ้า Error แสดงว่ามีฟิลด์นี้อยู่แล้ว ให้ข้ามไป (เงียบไว้)
        end;

        try
          QrAddCol.SQL.Add('ALTER TABLE LimitNum ADD (IF NOT EXISTS PayPcnt4 FLOAT)');
          QrAddCol.ExecSQL;
        except
          // ถ้า Error แสดงว่ามีฟิลด์นี้อยู่แล้ว ให้ข้ามไป (เงียบไว้)
        end;

        try
          QrAddCol.SQL.Add('ALTER TABLE LimitNum ADD (IF NOT EXISTS PayPcnt5 FLOAT)');
          QrAddCol.ExecSQL;
        except
          // ถ้า Error แสดงว่ามีฟิลด์นี้อยู่แล้ว ให้ข้ามไป (เงียบไว้)
        end;

        try
          QrAddCol.SQL.Add('ALTER TABLE LimitNum ADD (IF NOT EXISTS PayPcnt6 FLOAT)');
          QrAddCol.ExecSQL;
        except
          // ถ้า Error แสดงว่ามีฟิลด์นี้อยู่แล้ว ให้ข้ามไป (เงียบไว้)
        end;

        try
          QrAddCol.SQL.Add('ALTER TABLE LimitNum ADD (IF NOT EXISTS PayPcnt7 FLOAT)');
          QrAddCol.ExecSQL;
        except
          // ถ้า Error แสดงว่ามีฟิลด์นี้อยู่แล้ว ให้ข้ามไป (เงียบไว้)
        end;
      end;

      try
        if Database.Connected then
        begin
          try Limit3.Open; except end;
          try TbCust.Open; except end;
          try Lotto.Open; except end;
          try TbLocateNum.Open; except end;
        end;
      except
      end;
      edCustNo.Text := '0001';
      PanelCustName.Caption := 'เงินสด';
      NewRefreshBtnClick(Sender);
    end;
