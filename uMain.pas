      SetLength(Income,0);
      SetLength(Commis,0);
      SetLength(SumCom,0);
      SetLength(Total,0);
      SetLength(Win,0);
      SetLength(Pay,0);
      SetLength(Net,0);
    end; //record.count > 0
  end; //dm
  TbDealer.Free;
  QrDataRep.Free;
